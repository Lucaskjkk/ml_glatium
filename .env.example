# Copy to .env and fill with real values. Never commit .env.

# dump = restore local Postgres from file (recommended for local ML)
# live = direct READ ONLY connection to production ERP
ERP_SOURCE_MODE=dump
ERP_DUMP_PATH=data/dumps/pdv_prod.dump

# Target DB used as ERP source after restore
# - Homebrew local: postgresql://erp:erp@127.0.0.1:5432/pdv_prod
# - Docker compose postgres-erp: postgresql://erp:erp@127.0.0.1:5434/pdv_prod
ERP_DATABASE_URL=postgresql://erp:erp@127.0.0.1:5432/pdv_prod

# ML analytical database (separate)
ML_DATABASE_URL=postgresql://ml:ml@127.0.0.1:5433/ml_pdv

REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5000

API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me-in-production

MODEL_NAME=demand_forecasting
PREDICTION_HORIZON_DAYS=7

SYNC_INTERVAL_MINUTES=5
TRAINING_SCHEDULE_CRON=0 3 * * 0
